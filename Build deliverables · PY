def build_base(path):
    wb = openpyxl.Workbook()
    ws = wb.active; ws.title = "Data"
    cols = ["order_id", "order_date", "branch", "product", "channel", "units", "unit_price", "revenue"]
    ws.append(cols)
    for r in df[cols].itertuples(index=False):
        ws.append([r[0], r[1].to_pydatetime(), *r[2:]])
    for c in ws["B"][1:]: c.number_format = "yyyy-mm-dd"
    for c in ws[1]: c.font = Font(name="Arial", bold=True)
    wb.save(path)

def add_pivot_with_libreoffice(path):
    import uno
    from com.sun.star.beans import PropertyValue
    from com.sun.star.table import CellRangeAddress, CellAddress
    from com.sun.star.sheet.DataPilotFieldOrientation import ROW, COLUMN, DATA
    from com.sun.star.sheet.GeneralFunction import SUM
    prof = tempfile.mkdtemp()
    p = subprocess.Popen(["soffice", "--headless", "--norestore", f"-env:UserInstallation=file://{prof}",
                          "--accept=socket,host=localhost,port=2002;urp;"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        local = uno.getComponentContext()
        resolver = local.ServiceManager.createInstanceWithContext("com.sun.star.bridge.UnoUrlResolver", local)
        for _ in range(60):
            try:
                ctx = resolver.resolve("uno:socket,host=localhost,port=2002;urp;StarOffice.ComponentContext"); break
            except Exception: time.sleep(1)
        desktop = ctx.ServiceManager.createInstanceWithContext("com.sun.star.frame.Desktop", ctx)
        hidden = PropertyValue(); hidden.Name, hidden.Value = "Hidden", True
        doc = desktop.loadComponentFromURL("file://" + os.path.abspath(path), "_blank", 0, (hidden,))
        sheets = doc.Sheets
        sheets.insertNewByName("PivotTable", 1)
        rng = CellRangeAddress(); rng.Sheet = 0; rng.StartColumn = 0; rng.StartRow = 0
        rng.EndColumn = 7; rng.EndRow = N
        dps = sheets.getByName("PivotTable").DataPilotTables
        desc = dps.createDataPilotDescriptor(); desc.setSourceRange(rng)
        f = desc.DataPilotFields
        f.getByName("branch").Orientation = ROW
        f.getByName("channel").Orientation = COLUMN
        d = f.getByName("revenue"); d.Orientation = DATA; d.Function = SUM
        pos = CellAddress(); pos.Sheet = 1; pos.Column = 0; pos.Row = 2
        dps.insertNewByName("RevenueByBranchChannel", pos, desc)
        sheets.getByName("PivotTable").getCellByPosition(0, 0).String = "PivotTable: revenue (KES) by branch and channel"
        out = PropertyValue(); out.Name, out.Value = "FilterName", "Calc MS Excel 2007 XML"
        doc.storeToURL("file://" + os.path.abspath(path), (out,))
        doc.close(True)
        try: desktop.terminate()
        except Exception: pass
    finally:
        p.terminate()
        try: p.wait(10)
        except Exception: p.kill()
        shutil.rmtree(prof, ignore_errors=True)

def finish_workbook(path):
    wb = openpyxl.load_workbook(path)
    arial = lambda **k: Font(name="Arial", **k)
    # Region lookup
    rl = wb.create_sheet("RegionLookup")
    rl.append(["branch", "region"])
    for b, r in REGION.items(): rl.append([b, r])
    rl["D1"] = "Lookup table supplied by analyst: branch -> sales region (not in duka_sales.csv)."
    # Branch summary
    bs = wb.create_sheet("BranchSummary", 1)
    hdr = ["Branch", "Region (XLOOKUP)", "Orders (COUNTIFS)", "Revenue KES (SUMIFS)",
           "Revenue rank", "Orders rank", "pandas revenue (hardcoded check)", "Difference"]
    bs.append(hdr)
    rev, brn = f"Data!$H$2:$H${N+1}", f"Data!$C$2:$C${N+1}"
    for i, b in enumerate(branches_sorted, start=2):
        bs.append([b,
                   f"=_xlfn.XLOOKUP(A{i},RegionLookup!$A$2:$A$6,RegionLookup!$B$2:$B$6)",
                   f"=COUNTIFS({brn},A{i})",
                   f"=SUMIFS({rev},{brn},A{i})",
                   f"=RANK(D{i},$D$2:$D$6)",
                   f"=RANK(C{i},$C$2:$C$6)",
                   int(br.loc[b, "revenue"]),
                   f"=D{i}-G{i}"])
    t = 2 + len(branches_sorted)
    bs.append(["TOTAL", None, f"=SUM(C2:C{t-1})", f"=SUM(D2:D{t-1})", None, None, f"=SUM(G2:G{t-1})", f"=D{t}-G{t}"])
    bs[f"A{t+2}"] = "Column G holds the totals computed in pandas (hardcoded from the notebook) so the SUMIFS result can be checked; column H should be 0."
    bs[f"A{t+3}"] = "Branches are listed in descending revenue order. See the PivotTable sheet for revenue by branch and channel."
    for c in bs[1]:
        c.font = arial(bold=True, color="FFFFFF"); c.fill = PatternFill("solid", fgColor="1F4E78")
        c.alignment = Alignment(wrap_text=True, vertical="center")
    for row in bs.iter_rows(min_row=2, max_row=t):
        for c in row:
            c.font = arial(bold=(row[0].row == t))
            if c.column in (3, 4, 7, 8): c.number_format = "#,##0"
    for col, w in zip("ABCDEFGH", [14, 18, 16, 22, 13, 13, 28, 12]): bs.column_dimensions[col].width = w
    bs.row_dimensions[1].height = 32
    for ws in (wb["Data"], rl):
        for c in ws[1]: c.font = arial(bold=True)
    wb.calculation.fullCalcOnLoad = True
    wb.save(path)
    return t

def inject_cached_values(path, last_row):
    """openpyxl writes formulas without results; add the values so readers that
    do not recalculate (pandas, GitHub preview) still see numbers."""
    vals = {}
    for i, b in enumerate(branches_sorted, start=2):
        vals[f"B{i}"] = REGION[b]; vals[f"C{i}"] = int(br.loc[b, "orders"]); vals[f"D{i}"] = int(br.loc[b, "revenue"])
        vals[f"E{i}"] = int(br_rev.index.get_loc(b) + 1)
        vals[f"F{i}"] = int(br.orders.rank(ascending=False, method="min")[b]); vals[f"H{i}"] = 0
    vals[f"C{last_row}"] = n_orders; vals[f"D{last_row}"] = int(total_rev)
    vals[f"G{last_row}"] = int(total_rev); vals[f"H{last_row}"] = 0
    wb = openpyxl.load_workbook(path); idx = wb.sheetnames.index("BranchSummary") + 1; wb.close()
    ns = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
    tmp = path + ".tmp"
    with zipfile.ZipFile(path) as zin, zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED) as zout:
        target = None
        wbx = etree.fromstring(zin.read("xl/workbook.xml"))
        rels = etree.fromstring(zin.read("xl/_rels/workbook.xml.rels"))
        sheet = wbx.findall(f"{{{ns}}}sheets/{{{ns}}}sheet")[idx - 1]
        rid = sheet.get("{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id")
        for r in rels:
            if r.get("Id") == rid: target = "xl/" + r.get("Target").lstrip("/").replace("xl/", "")
        for item in zin.infolist():
            data = zin.read(item.filename)
            if item.filename == target:
                root = etree.fromstring(data)
                for c in root.iter(f"{{{ns}}}c"):
                    if c.find(f"{{{ns}}}f") is not None and c.get("r") in vals:
                        v = c.find(f"{{{ns}}}v")
                        if v is None: v = etree.SubElement(c, f"{{{ns}}}v")
                        v.text = str(vals[c.get("r")])
                        if isinstance(vals[c.get("r")], str): c.set("t", "str")
                data = etree.tostring(root, xml_declaration=True, encoding="UTF-8", standalone=True)
            zout.writestr(item, data)
    os.replace(tmp, path)

XL = "excel/duka_branch_summary.xlsx"
build_base(XL)
add_pivot_with_libreoffice(XL)
last = finish_workbook(XL)
inject_cached_values(XL, last)
print("Excel built:", XL)

